                  {
                      "parameters":  {
                                         "jsCode":  "const lookup = $input.first().json;\nconst original = $(\u0027Preparar development poles\u0027).item.json;\nconst data = Array.isArray(lookup.data) ? lookup.data : [];\nconst existing = data[0];\nconst existingId = existing?.documentId ?? existing?.id ?? null;\n\nconst existingRoot = existing?.attributes ?? existing ?? {};\nconst existingZones = Array.isArray(existingRoot.zones) ? existingRoot.zones : [];\nconst zoneKey = (zone) =\u003e String(zone?.code || zone?.name || \u0027\u0027).trim().toUpperCase();\nconst loteKey = (lote) =\u003e String(lote?.code || lote?.name || lote?.nip || \u0027\u0027).trim().toUpperCase();\nconst byKey = (items, keyFn) =\u003e new Map(items.map((item) =\u003e [keyFn(item), item]).filter(([key]) =\u003e key));\n\nconst payload = JSON.parse(JSON.stringify(original.strapiPayload));\nconst existingZonesByKey = byKey(existingZones, zoneKey);\n\npayload.data.zones = (payload.data.zones || []).map((zone) =\u003e {\n  const existingZone = existingZonesByKey.get(zoneKey(zone));\n  const nextZone = { ...zone };\n\n  if (existingZone?.id) {\n    nextZone.id = existingZone.id;\n  }\n\n  const existingLotes = Array.isArray(existingZone?.lotes) ? existingZone.lotes : [];\n  const existingLotesByKey = byKey(existingLotes, loteKey);\n  nextZone.lotes = (zone.lotes || []).map((lote) =\u003e {\n    const existingLote = existingLotesByKey.get(loteKey(lote));\n    return existingLote?.id ? { ...lote, id: existingLote.id } : lote;\n  });\n\n  return nextZone;\n});\n\nreturn [{\n  json: {\n    ...original,\n    strapiPayload: payload,\n    strapiPoleExiste: Boolean(existingId),\n    strapiPoleId: existingId,\n    strapiMethod: existingId ? \u0027PUT\u0027 : \u0027POST\u0027,\n    strapiUrl: existingId ? \u0027https://zeemsv-sta.uniteltmais.cv/zeemsv-cms/api/development-poles/\u0027 + existingId + \u0027?locale=pt\u0026populate=*\u0027 : \u0027https://zeemsv-sta.uniteltmais.cv/zeemsv-cms/api/development-poles?locale=pt\u0026populate=*\u0027,\n    strapiLookup: lookup\n  }\n}];"
                                     },
