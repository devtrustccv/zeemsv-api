                      "parameters":  {
                                         "jsCode":  "const response = $input.first().json;\nconst envelope = Array.isArray(response) ? response[0] : response;\nconst zonas = Array.isArray(envelope?.data) ? envelope.data : [];\nconst firstDefined = (...values) =\u003e values.find((value) =\u003e value !== undefined \u0026\u0026 value !== null);\nconst asArray = (value) =\u003e Array.isArray(value) ? value : [];\nconst asNumber = (value) =\u003e {\n  if (value === null || value === undefined || value === \u0027\u0027) return null;\n  const number = Number(String(value).replace(\u0027,\u0027, \u0027.\u0027));\n  return Number.isFinite(number) ? number : null;\n};\nconst firstNumber = (...values) =\u003e {\n  for (const value of values) {\n    const number = asNumber(value);\n    if (number !== null) return number;\n  }\n  return null;\n};\nconst sumArea = (items) =\u003e items.reduce((total, item) =\u003e total + (firstNumber(item.area, item.area_inicial, item.areaInicial) ?? 0), 0);\nconst containsAny = (value, words) =\u003e {\n  if (value === null || value === undefined) return false;\n  const normalized = String(value).normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027).toUpperCase();\n  return words.some((word) =\u003e normalized.includes(word));\n};\nconst statusText = (lote) =\u003e firstDefined(lote.situacao, lote.dmSituacaoCd, lote.dm_situacao_cd, lote.disponibilidade, lote.dmDisponibilidade, lote.dm_disponibilidade);\nconst isLivre = (lote) =\u003e containsAny(statusText(lote), [\u0027LIVRE\u0027, \u0027DISPONIVEL\u0027]);\nconst isOcupado = (lote) =\u003e containsAny(statusText(lote), [\u0027OCUP\u0027, \u0027RESERVADO\u0027, \u0027CEDIDO\u0027, \u0027INDISPONIVEL\u0027]);\nconst normalizeCode = (value, fallback) =\u003e String(value || fallback || \u0027SEM-CODIGO\u0027).trim().toUpperCase();\nconst normalizeCoordinates = (coordenadas, pontos = []) =\u003e {\n  if (coordenadas \u0026\u0026 typeof coordenadas === \u0027object\u0027 \u0026\u0026 !Array.isArray(coordenadas)) {\n    if (Array.isArray(coordenadas.coordinates)) return coordenadas;\n    if (Array.isArray(coordenadas.coordenadas)) return { coordinates: coordenadas.coordenadas };\n  }\n  if (Array.isArray(coordenadas)) return { coordinates: coordenadas };\n\n  const coordinates = asArray(pontos)\n    .map((ponto) =\u003e [asNumber(firstDefined(ponto.coordenadaX, ponto.coordenada_x)), asNumber(firstDefined(ponto.coordenadaY, ponto.coordenada_y))])\n    .filter(([x, y]) =\u003e x !== null \u0026\u0026 y !== null);\n\n  return coordinates.length \u003e 0 ? { coordinates } : null;\n};\nconst loteCode = (zonaCode, lote) =\u003e {\n  const raw = firstDefined(lote.code, lote.refLote, lote.ref_lote, lote.nip, lote.id);\n  const value = String(raw || \u0027\u0027).trim();\n  if (!value) return null;\n  return value.toUpperCase().startsWith(`${zonaCode}-`) ? value : `${zonaCode}-L${value}`;\n};\nconst loteName = (lote) =\u003e {\n  const raw = firstDefined(lote.name, lote.refLote, lote.ref_lote, lote.nip, lote.id);\n  return raw ? `Lote ${raw}` : \u0027Lote\u0027;\n};\n\nconst grouped = new Map();\n\nfor (const zona of zonas) {\n  const code = normalizeCode(firstDefined(zona.sigla, zona.code), zona.id);\n  if (!grouped.has(code)) {\n    grouped.set(code, {\n      code,\n      name: code,\n      zones: []\n    });\n  }\n\n  const lotesOrigem = asArray(zona.lotes);\n  const lotesLivres = lotesOrigem.filter(isLivre);\n  const lotesOcupados = lotesOrigem.filter(isOcupado);\n  const areaTotalFallback = sumArea(lotesOrigem);\n  const areaDisponivelFallback = sumArea(lotesLivres);\n  const areaOcupadaFallback = lotesOcupados.length \u003e 0 ? sumArea(lotesOcupados) : Math.max(0, (areaTotalFallback || 0) - (areaDisponivelFallback || 0));\n\n  const parques = asArray(zona.parques).map((parque) =\u003e ({\n    code: firstDefined(parque.sigla, parque.code) ?? null,\n    name: firstDefined(parque.nome, parque.name) ?? null,\n    estado: parque.estado ?? null\n  }));\n  const lotes = lotesOrigem.map((lote) =\u003e ({\n    code: loteCode(code, lote),\n    name: loteName(lote),\n    description: firstDefined(lote.description, lote.refCm, lote.ref_cm) ? `Referencia CM: ${firstDefined(lote.description, lote.refCm, lote.ref_cm)}` : null,\n    coordinates: normalizeCoordinates(firstDefined(lote.coordenadas, lote.coordinates), []),\n    parque: firstDefined(lote.parque, lote.parqueNome, lote.parque_nome) ?? null,\n    nip: lote.nip ?? null,\n    zona: firstDefined(lote.zona, zona.nome, zona.name) ?? null,\n    area: firstNumber(lote.area, lote.area_inicial, lote.areaInicial),\n    situacao: firstDefined(lote.situacao, lote.dmSituacaoCd, lote.dm_situacao_cd) ?? null,\n    disponibilidade: firstDefined(lote.disponibilidade, lote.dmDisponibilidade, lote.dm_disponibilidade) ?? null\n  })).filter((lote) =\u003e lote.code || lote.name || lote.coordinates);\n\n  grouped.get(code).zones.push({\n    code,\n    name: firstDefined(zona.nome, zona.name) ?? code,\n    description: zona.description ?? null,\n    coordinates: normalizeCoordinates(firstDefined(zona.coordenadas, zona.coordinates), zona.pontos),\n    parque: parques.length === 1 ? firstDefined(parques[0].name, parques[0].code) : code,\n    areaTotal: firstNumber(zona.areaTotal, zona.area_total) ?? areaTotalFallback,\n    areaTotalDisponivel: firstNumber(zona.areaTotalDisponivel, zona.area_total_disponivel) ?? areaDisponivelFallback,\n    areaTotalOcupada: firstNumber(zona.areaTotalOcupada, zona.area_total_ocupada) ?? areaOcupadaFallback,\n    quantidadeLotesLivres: firstNumber(zona.quantidadeLotesLivres, zona.quantidade_lotes_livres) ?? lotesLivres.length,\n    quantidadeLotesOcupados: firstNumber(zona.quantidadeLotesOcupados, zona.quantidadeLotesOcupadas, zona.quantidade_lotes_ocupados, zona.quantidade_lotes_ocupadas) ?? lotesOcupados.length,\n    parques,\n    lotes\n  });\n}\n\nreturn [...grouped.values()].map((pole) =\u003e ({\n  json: {\n    code: pole.code,\n    zonasCount: pole.zones.length,\n    lotesCount: pole.zones.reduce((total, zone) =\u003e total + asArray(zone.lotes).length, 0),\n    strapiPayload: {\n      data: {\n        locale: \u0027pt\u0027,\n        name: pole.name,\n        code: pole.code,\n        zones: pole.zones\n      }\n    }\n  }\n}));"
